<Window x:Class="GuildManager.QuestShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="Boutique de Contrats" Height="650" Width="1050" Background="#1A1A1A">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="BOUTIQUE DE CONTRATS" Foreground="#FFFFCE00" FontSize="24" FontWeight="Bold" FontFamily="Castellar" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Image Source="/assets/UI/Icon/Gold_Icon.png" Height="28" Width="28" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtOrDisponible" Text="1000 Or" Foreground="#FFFFB700" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- LISTE DES CONTRATS EN VENTE -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel x:Name="StackPanelBoutique">

                <!-- CONTRAT 5 : Quest Circle -->
                <Border BorderBrush="#44FFFFFF" BorderThickness="1" Background="#252525" CornerRadius="5" Margin="0,0,0,15" Padding="12">
                    <Grid Height="100">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="/assets/UI/Quest_Illustrations/Quest_Circle.png" Stretch="Fill"/>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Chapitre 5 : Le Cercle Invoqué" Foreground="#FFFFCE00" FontSize="12" FontStyle="Italic"/>
                            <TextBlock Text="Quest Circle" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,2,0,2"/>
                            <TextBlock Text="Démantelez le rituel sectaire avant l'invocation suprême." Foreground="#FFCCCCCC" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="Récompenses : 600 Or | 600 XP" Foreground="#FF00A7FF" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="Prix : 1 000 Or" Foreground="#FFFFB700" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <Button x:Name="BtnAchatCircle" Click="AcheterCircle_Click" Content="Acheter" Width="130" Height="32" Background="#FF1BE100" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTRAT 6 : Quest Dragon -->
                <Border BorderBrush="#44FFFFFF" BorderThickness="1" Background="#252525" CornerRadius="5" Margin="0,0,0,15" Padding="12">
                    <Grid Height="100">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="/assets/UI/Quest_Illustrations/Quest_Dragon.png" Stretch="Fill"/>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Chapitre 6 : La Cime Désolée" Foreground="#FFFFCE00" FontSize="12" FontStyle="Italic"/>
                            <TextBlock Text="Quest Dragon" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,2,0,2"/>
                            <TextBlock Text="Traquez le dragon rouge qui ravage les terres du Nord." Foreground="#FFCCCCCC" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="Récompenses : 1 000 Or | 1 000 XP" Foreground="#FF00A7FF" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="Prix : 2 500 Or" Foreground="#FFFFB700" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <Button x:Name="BtnAchatDragon" Click="AcheterDragon_Click" Content="Acheter" Width="130" Height="32" Background="#FF1BE100" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTRAT 7 : Quest Fadriass -->
                <Border BorderBrush="#44FFFFFF" BorderThickness="1" Background="#252525" CornerRadius="5" Margin="0,0,0,15" Padding="12">
                    <Grid Height="100">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="/assets/UI/Quest_Illustrations/Quest_Fadriass.png" Stretch="Fill"/>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Chapitre 7 : L'Ombre de Fadriass" Foreground="#FFFFCE00" FontSize="12" FontStyle="Italic"/>
                            <TextBlock Text="Quest Fadriass" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,2,0,2"/>
                            <TextBlock Text="Affrontez le seigneur démon Fadriass dans son sanctuaire." Foreground="#FFCCCCCC" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="Récompenses : 2 000 Or | 2 500 XP" Foreground="#FF00A7FF" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="Prix : 5 000 Or" Foreground="#FFFFB700" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <Button x:Name="BtnAchatFadriass" Click="AcheterFadriass_Click" Content="Acheter" Width="130" Height="32" Background="#FF1BE100" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- PIED DE PAGE -->
        <Button Grid.Row="2" Click="Fermer_Click" Content="Fermer" Width="120" Height="35" HorizontalAlignment="Right" Background="#333333" Foreground="White" BorderBrush="Gray" Cursor="Hand"/>
    </Grid>
</Window>