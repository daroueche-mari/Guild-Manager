<Window x:Class="GuildManager.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="GameWindow" Height="680" Width="1050" 
        Background="#1A1A1A">

    <Grid>
        <!-- FOND DE LA QUÊTE EN COURS -->
        <Image x:Name="FondQueteChoisi" 
               Stretch="UniformToFill" 
               Source="/assets/UI/Quest_Illustrations/Quest_Fadriass.png" 
               Opacity="0.4"/>

        <!-- LAYOUT PRINCIPAL -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <!-- Barre Supérieure Header -->
                <RowDefinition Height="*"/>
                <!-- Zone de Jeu Principale -->
            </Grid.RowDefinitions>

            <!-- ================= HEADER SUPÉRIEUR ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Support Titre -->
                <Border Grid.Column="0" Background="#7F000000" CornerRadius="5" Padding="10,5" HorizontalAlignment="Left">
                    <TextBlock x:Name="TitreFenetre" 
                               Text="PHASE DE RESOLUTION" 
                               Foreground="#FFB20000" 
                               FontSize="22" 
                               FontWeight="Bold"
                               FontFamily="Castellar" 
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Bouton Retour -->
                <Button Grid.Column="1" 
                        Click="BackToQuestBtn" 
                        x:Name="BtnRetourQuest" 
                        Content="Retour aux Quêtes" 
                        Width="160" Height="35" 
                        Background="#FF18C400" Foreground="White" 
                        FontWeight="Bold" FontSize="13"
                        Cursor="Hand" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Infos Joueur -->
                <Border Grid.Column="2" Background="#7F000000" CornerRadius="5" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="NomJoueur" 
                               Text="Nom du joueur" 
                               Foreground="#FFFFFD00" 
                               FontSize="16" FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- ================= CONTENU PRINCIPAL ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <!-- Panneau Ennemi -->
                    <ColumnDefinition Width="*"/>
                    <!-- Panneau Histoire / Journal -->
                    <ColumnDefinition Width="320"/>
                    <!-- Panneau Aventuriers -->
                </Grid.ColumnDefinitions>

                <!-- 1. BLOC ENNEMI (GAUCHE) -->
                <Border Grid.Column="0" Background="#B3000000" BorderBrush="#FF555555" BorderThickness="2" CornerRadius="8" Margin="5">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Avatar Ennemi -->
                        <Image x:Name="Ennemi" 
                               Grid.Row="0" 
                               Stretch="Uniform" 
                               Source="/assets/Personnages/Personnages-Importants/Fadriass.png" 
                               Margin="0,0,0,10"/>

                        <!-- Cartouche Nom & Type -->
                        <Border Grid.Row="1" Background="#4C000000" Padding="5">
                            <StackPanel>
                                <TextBlock x:Name="NomEnnemi" 
                                           Text="Fadriass" 
                                           Foreground="White" 
                                           FontSize="18" FontWeight="Bold" 
                                           TextAlignment="Center" 
                                           TextWrapping="NoWrap" 
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock x:Name="TypeEnnemi" 
                                           Text="BOSS" 
                                           Foreground="#FFCCCCCC" 
                                           FontSize="12" 
                                           TextAlignment="Center" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. BLOC HISTOIRE (CENTRE) -->
                <Border Grid.Column="1" Background="#B3000000" BorderBrush="#FF555555" BorderThickness="2" CornerRadius="8" Margin="5">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="— JOURNAL DE QUÊTE —" 
                                   Foreground="#FFD4AF37" FontSize="16" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="Histoire" 
                                       Text="Journal de la quête..." 
                                       Foreground="White" 
                                       FontSize="14" 
                                       TextWrapping="Wrap" 
                                       LineHeight="20"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 3. BLOC AVENTURIERS (DROITE) -->
                <Border Grid.Column="2" Background="#B3000000" BorderBrush="#FF555555" BorderThickness="2" CornerRadius="8" Margin="5">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.8*"/>
                            <!-- Combattant Principal -->
                            <RowDefinition Height="1.2*"/>
                            <!-- Soutiens 1 & 2 -->
                            <RowDefinition Height="Auto"/>
                            <!-- Noms des Aventuriers -->
                        </Grid.RowDefinitions>

                        <!-- Combattant 1 (Principal) -->
                        <Border Grid.Row="0" Margin="2" BorderBrush="#FF888888" BorderThickness="1" Background="#26000000">
                            <Image x:Name="Combattant1" 
                                   Stretch="Uniform" 
                                   Source="/assets/Personnages/Aventuriers-Spéciaux/Fùchóu.png"/>
                        </Border>

                        <!-- Combattants 2 & 3 (Soutiens) -->
                        <Grid Grid.Row="1" Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="2" BorderBrush="#FF666666" BorderThickness="1" Background="#26000000">
                                <Image x:Name="Combattant2" 
                                       Stretch="Uniform" 
                                       Source="/assets/Personnages/Aventuriers/Profile_HBarabarian1.png"/>
                            </Border>

                            <Border Grid.Column="1" Margin="2" BorderBrush="#FF666666" BorderThickness="1" Background="#26000000">
                                <Image x:Name="Combattant3" 
                                       Stretch="Uniform" 
                                       Source="/assets/Personnages/Aventuriers/Profile_HMage1.png"/>
                            </Border>
                        </Grid>

                        <!-- Section Noms (Agrandie & Auto-Ajustée) -->
                        <Border Grid.Row="2" Background="#4C000000" Padding="5">
                            <StackPanel>
                                <!-- Nom Combattant 1 -->
                                <TextBlock x:Name="NomAventurier1" 
                                           Text="Aventurier Principal" 
                                           Foreground="#FF00FFCC" 
                                           FontSize="15" FontWeight="Bold" 
                                           TextAlignment="Center" 
                                           TextWrapping="NoWrap" 
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Noms Soutiens -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="NomAventurier2" 
                                               Grid.Column="0"
                                               Text="Soutien 1" 
                                               Foreground="White" 
                                               FontSize="12" 
                                               TextAlignment="Center" 
                                               TextWrapping="NoWrap" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="2,0"/>

                                    <TextBlock x:Name="NomAventurier3" 
                                               Grid.Column="1"
                                               Text="Soutien 2" 
                                               Foreground="White" 
                                               FontSize="12" 
                                               TextAlignment="Center" 
                                               TextWrapping="NoWrap" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="2,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>