<Window x:Class="GuildManager.ChoiceCharacter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Sélection des Aventuriers" Height="650" Width="1080" Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Zone principale de sélection -->
            <RowDefinition Height="*"/>
            <!-- Pied de page et emplacements d'escouade -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="PRÉPARATION DE LA QUÊTE" Foreground="#FFFFCE00" FontSize="20" FontWeight="Bold" FontFamily="Castellar"/>
                <TextBlock x:Name="TxtNomQuete" Text="Nomdelaquete" Foreground="#FF00FFF1" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Click="DeclineQuestBtn_Click" Content="Annuler" HorizontalAlignment="Right" Width="100" Height="30" Background="#333333" Foreground="White" BorderBrush="Gray" Cursor="Hand"/>
        </DockPanel>

        <!-- LISTE DES AVENTURIERS DISPONIBLES (SELECTION MULTIPLE) -->
        <Grid Grid.Row="1">
            <GroupBox Header="Sélectionnez les membres de l'escouade (Max 3)" Foreground="#FFFFCE00" BorderBrush="#55FFFFFF" Background="#2A2A2A" Padding="10">
                <ListView x:Name="ListViewAdventurers" 
                          SelectionMode="Multiple" 
                          SelectionChanged="ListViewAdventurers_SelectionChanged"
                          Background="#1E1E1E" 
                          Foreground="White" 
                          BorderThickness="0">

                    <!-- Disposition sous forme de grille -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="1000"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <!-- Template d'un aventurier dans la liste -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="230" Height="105" Margin="5" Background="#333333" BorderBrush="#FFFFCE00" BorderThickness="1" CornerRadius="4" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Portrait -->
                                    <Image Grid.Column="0" Source="{Binding ImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Infos aventurier -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Classe}" Foreground="#FF00FF17" FontSize="11" Margin="0,1,0,0"/>

                                        <!-- Stats : Niveau et Puissance -->
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Niv. " Foreground="Gray" FontSize="11"/>
                                            <TextBlock Text="{Binding Level}" Foreground="#FF00FFF1" FontWeight="Bold" FontSize="11" Margin="0,0,10,0"/>

                                            <TextBlock Text="Pws. " Foreground="Gray" FontSize="11"/>
                                            <!-- Binding Power/Puissance (s'adapte à ta propriété C# : Power, Attack, Puissance, etc.) -->
                                            <TextBlock Text="{Binding Power}" Foreground="#FFFF5555" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>
        </Grid>

        <!-- PIED DE PAGE : COMPOSITION D'ESCOUADE (3 CASES) & CONFIRMATION -->
        <DockPanel Grid.Row="2" Margin="0,15,0,0">
            <!-- Compteur & Puissance Totale à gauche -->
            <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sélectionnés : " Foreground="White" FontSize="13"/>
                    <TextBlock x:Name="TxtCountSelection" Text="0 / 3" Foreground="#FFFFCE00" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
                <!-- Indication du Bonus de Niveau du Joueur -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Bonus de Guilde : " Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="TxtBonusPower" Text="+0" Foreground="#FF00FF17" FontWeight="Bold" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Puissance Escouade : " Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalPower" Text="0" Foreground="#FFFF5555" FontWeight="Bold" FontSize="12"/>
                    
                </StackPanel>
            </StackPanel>

            <!-- Bouton à droite -->
            <Button Click="LaunchQuestBtn_Click" DockPanel.Dock="Right" Content="Lancer l'Expédition" HorizontalAlignment="Right" Width="170" Height="50" Background="#B2F10000" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Margin="15,0,0,0"/>

            <!-- 3 CASES D'AVENTURIERS SÉLECTIONNÉS AU CENTRE/DROITE -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Case Slot 1 -->
                <Border x:Name="Slot1Border" Width="145" Height="52" Margin="5,0" Background="#2A2A2A" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="4" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="Slot1Image" Grid.Column="0" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock x:Name="Slot1Name" Text="[Vide]" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Slot1Level" Text="" Foreground="#FF00FFF1" FontSize="10"/>
                                <TextBlock x:Name="Slot1Power" Text="" Foreground="#FFFF5555" FontSize="10" Margin="5,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Case Slot 2 -->
                <Border x:Name="Slot2Border" Width="145" Height="52" Margin="5,0" Background="#2A2A2A" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="4" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="Slot2Image" Grid.Column="0" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock x:Name="Slot2Name" Text="[Vide]" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Slot2Level" Text="" Foreground="#FF00FFF1" FontSize="10"/>
                                <TextBlock x:Name="Slot2Power" Text="" Foreground="#FFFF5555" FontSize="10" Margin="5,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Case Slot 3 -->
                <Border x:Name="Slot3Border" Width="145" Height="52" Margin="5,0" Background="#2A2A2A" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="4" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="Slot3Image" Grid.Column="0" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock x:Name="Slot3Name" Text="[Vide]" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Slot3Level" Text="" Foreground="#FF00FFF1" FontSize="10"/>
                                <TextBlock x:Name="Slot3Power" Text="" Foreground="#FFFF5555" FontSize="10" Margin="5,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>