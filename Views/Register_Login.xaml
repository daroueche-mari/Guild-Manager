<Window x:Class="GuildManager.Register_Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Connexion / Inscription" Height="650" Width="1050" Background="#1E1E1E">

    <Grid>
        <!-- HEADER -->
        <Image x:Name="SupportTitreFenetreConnexion" HorizontalAlignment="Left" Height="274" Margin="18,-111,0,0" VerticalAlignment="Top" Width="713" Panel.ZIndex="1" Source="/assets/UI/Background/Background_Top.png"/>
        <TextBlock x:Name="TitreFenetrerConnexion" HorizontalAlignment="Left" Margin="87,9,0,0" TextWrapping="Wrap" Text="CONNEXION / INSCRIPTION" VerticalAlignment="Top" Width="380" Panel.ZIndex="2" Background="#7F000000" Foreground="#B2FF0000" FontSize="21" FontFamily="Castellar"/>

        <Button Click="BacktoMenuFromLogWindowBtn" Content="Fermer" HorizontalAlignment="Right" Margin="0,20,20,0" VerticalAlignment="Top" Panel.ZIndex="2" Width="110" Height="30" Background="#333333" Foreground="White" BorderBrush="Gray" Cursor="Hand"/>

        <!-- CONTENEUR PRINCIPAL (PANNEAU GAUCHE: INSCRIPTION | PANNEAU DROIT: CONNEXION) -->
        <Grid Margin="30,120,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SECTION INSCRIPTION (GAUCHE) -->
            <Border Grid.Column="0" Background="#2A2A2A" BorderBrush="#FFFFCE00" BorderThickness="1" CornerRadius="8" Padding="25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="INSCRIPTION" Foreground="#FFFFCE00" FontSize="20" FontWeight="Bold" FontFamily="Castellar" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Nom d'utilisateur -->
                    <TextBlock Text="Nom d'utilisateur :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="RegisterUsernameTxt" Height="32" Margin="0,0,0,15" VerticalContentAlignment="Center" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="8,0"/>

                    <!-- Mot de passe -->
                    <TextBlock Text="Mot de passe :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="RegisterPasswordTxt" Height="32" Margin="0,0,0,15" VerticalContentAlignment="Center" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="8,0"/>

                    <!-- Confirmation Mot de passe -->
                    <TextBlock Text="Confirmer le mot de passe :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="RegisterConfirmPasswordTxt" Height="32" Margin="0,0,0,25" VerticalContentAlignment="Center" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="8,0"/>

                    <!-- Bouton Validation -->
                    <Button Click="RegisterBtn_Click" Content="S'inscrire" Height="40" Background="#B2F10000" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- SECTION CONNEXION (DROITE) -->
            <Border Grid.Column="2" Background="#2A2A2A" BorderBrush="#FFFFCE00" BorderThickness="1" CornerRadius="8" Padding="25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONNEXION" Foreground="#FFFFCE00" FontSize="20" FontWeight="Bold" FontFamily="Castellar" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Nom d'utilisateur -->
                    <TextBlock Text="Nom d'utilisateur :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginUsernameTxt" Height="32" Margin="0,0,0,15" VerticalContentAlignment="Center" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="8,0"/>

                    <!-- Mot de passe -->
                    <TextBlock Text="Mot de passe :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="LoginPasswordTxt" Height="32" Margin="0,0,0,67" VerticalContentAlignment="Center" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="8,0"/>

                    <!-- Bouton Validation -->
                    <Button Click="LoginBtn_Click" Content="Se Connecter" Height="40" Background="#B2F10000" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>