<Window x:Class="GuildManager.AddCharacters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Recruter un Aventurier" Height="650" Width="1050" Background="#1E1E1E">

    <Grid>
        <!-- HEADER -->
        <Image x:Name="SupportTitreFenetreAjouterPersonnage" HorizontalAlignment="Left" Height="274" Margin="18,-111,0,0" VerticalAlignment="Top" Width="713" Panel.ZIndex="1" Source="/assets/Ui/Background/Background_Top.png"/>
        <TextBlock x:Name="TitreFenetreAjouterPersonnage" HorizontalAlignment="Left" Margin="87,9,0,0" TextWrapping="Wrap" Text="RECRUTER AVENTURIER" VerticalAlignment="Top" Width="330" Panel.ZIndex="2" Background="#7F000000" Foreground="#B2FF0000" FontSize="21" FontFamily="Castellar"/>

        <Button Click="BackToAdventurerManageFromAddCharacterBtn" Content="Fermer" HorizontalAlignment="Right" Margin="0,20,20,0" VerticalAlignment="Top" Panel.ZIndex="2" Width="108" Height="30" Foreground="White" Background="#333333" BorderBrush="Gray" Cursor="Hand"/>

        <!-- PANNEAU CENTRAL / FORMULAIRE -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Height="520" Margin="0,40,0,0">
            <!-- Arrière-plan du formulaire -->
            <Rectangle Fill="#2A2A2A" Stroke="#FFFFCE00" StrokeThickness="1" RadiusX="8" RadiusY="8"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
                <StackPanel Margin="10">
                    <TextBlock Text="Nouveau Membre" Foreground="#FFFFCE00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" FontFamily="Castellar"/>

                    <!-- 1. IMAGEPATH -->
                    <TextBlock Text="Chemin du portrait (ImagePath) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="Imagepathforaddcharacter" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="5,0" Text="/assets/Personnages/Aventuriers/Default_Avatar.png"/>
                        <Button Content="Parcourir..." Grid.Column="1" Height="28" Margin="8,0,0,0" Padding="10,0" Background="#333333" Foreground="White" BorderBrush="#55FFFFFF" Click="BrowseImage_Click"/>
                    </Grid>

                    <!-- 2. NAME -->
                    <TextBlock Text="Nom (Name) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="Nomforaddcharacter" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="5,0"/>

                    <!-- 3. AMELIORATE (FIXE EN TEXTBLOCK) -->
                    <TextBlock Text="Coût d'amélioration (Ameliorate) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <Border Height="28" Margin="0,0,0,12" Background="#1E1E1E" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="Ameliorateforaddcharacter" Text="100" Foreground="White" VerticalAlignment="Center" Padding="5,0"/>
                    </Border>

                    <!-- 4. BREED -->
                    <TextBlock Text="Race (Breed) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="Breedforaddcharacter" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="Black">
                        <ComboBoxItem Content="Humain" IsSelected="True"/>
                        <ComboBoxItem Content="Elfe"/>
                        <ComboBoxItem Content="Nain"/>
                    </ComboBox>

                    <!-- 5. CLASSE -->
                    <TextBlock Text="Classe :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="Classeforaddcharacter" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="Black">
                        <ComboBoxItem Content="Guerrier" IsSelected="True"/>
                        <ComboBoxItem Content="Barbare"/>
                        <ComboBoxItem Content="Tank"/>
                        <ComboBoxItem Content="Voleur"/>
                        <ComboBoxItem Content="Rôdeur"/>
                        <ComboBoxItem Content="Mage"/>
                        <ComboBoxItem Content="Prêtre"/>
                    </ComboBox>

                    <!-- 6. LEVEL (FIXE EN TEXTBLOCK) -->
                    <TextBlock Text="Niveau initial (Level) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <Border Height="28" Margin="0,0,0,12" Background="#1E1E1E" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="Levelforaddcharacter" Text="1" Foreground="White" VerticalAlignment="Center" Padding="5,0"/>
                    </Border>

                    <!-- 7. POWER (FIXE EN TEXTBLOCK) -->
                    <TextBlock Text="Puissance initiale (Power) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <Border Height="28" Margin="0,0,0,12" Background="#1E1E1E" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="Powerforaddcharacter" Text="50" Foreground="White" VerticalAlignment="Center" Padding="5,0"/>
                    </Border>

                    <!-- 8. TYPE (FIXE EN TEXTBLOCK) -->
                    <TextBlock Text="Type :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <Border Height="28" Margin="0,0,0,12" Background="#1E1E1E" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="Typeforaddcharacter" Text="Classique" Foreground="White" VerticalAlignment="Center" Padding="5,0"/>
                    </Border>

                    <!-- 9. INVENTORY -->
                    <TextBlock Text="Équipement initial (Inventory) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="Inventoryforaddcharacter" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="5,0" Text="Épée en bois"/>

                    <!-- 10. Infos -->
                    <TextBlock Text="Remarques / Informations (Infos) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="Infosforaddcharacter" Height="50" Margin="0,0,0,20" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#1E1E1E" BorderBrush="#55FFFFFF" Foreground="White" Padding="5"/>

                    <!-- BOUTON DE VALIDATION -->
                    <Button Click="NewAdventurerBtn" Content="Confirmer le Recrutement" Height="36" Background="#B2F10000" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>