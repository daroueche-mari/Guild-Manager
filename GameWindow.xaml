<Window x:Class="GuildManagerProject.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManagerProject"
        mc:Ignorable="d"
        Title="GameWindow" Height="650" Width="1050" Background="#7F000000">
    <Grid Margin="10,75,10,1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRE SUPÉRIEURE (Gold / Level) -->

        <!-- TITRE PRINCIPAL + BOUTON RETOUR -->
        <Image HorizontalAlignment="Center" Height="284" Margin="0,111,0,0" Grid.Row="2" VerticalAlignment="Top" Width="560" Source="/Background_Quest_Resolution.png" Panel.ZIndex="1"/>
        <Image HorizontalAlignment="Center" Height="687" Margin="0,52,0,0" Grid.Row="1" VerticalAlignment="Top" Width="1030" Source="/Quest_Fadriass.png" Grid.RowSpan="2"/>
        <Rectangle HorizontalAlignment="Left" Height="383" Margin="20,38,0,0" Grid.Row="2" Stroke="Black" VerticalAlignment="Top" Width="199" Panel.ZIndex="1" Fill="#7F000000"/>
        <Rectangle HorizontalAlignment="Left" Height="383" Margin="786,76,0,0" Grid.Row="2" Stroke="Black" VerticalAlignment="Top" Width="225" Panel.ZIndex="1" Fill="#7F000000"/>
        <Rectangle HorizontalAlignment="Left" Height="50" Margin="19,472,0,0" Grid.Row="2" Stroke="Black" VerticalAlignment="Top" Width="199" Panel.ZIndex="1" Fill="#7F000000"/>
        <Rectangle HorizontalAlignment="Left" Height="50" Margin="786,475,0,0" Grid.Row="2" Stroke="Black" VerticalAlignment="Top" Width="225" Panel.ZIndex="1" Fill="#7F000000"/>
        <TextBox HorizontalAlignment="Left" Margin="83,472,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Fadriass" VerticalAlignment="Top" Width="71" Panel.ZIndex="1" TextChanged="TextBox_TextChanged" Background="{x:Null}" Foreground="White" FontSize="17" BorderBrush="{x:Null}"/>
        <TextBox HorizontalAlignment="Left" Margin="95,500,0,0" Grid.Row="2" TextWrapping="Wrap" Text="BOSS" VerticalAlignment="Top" Width="49" Panel.ZIndex="1" TextChanged="TextBox_TextChanged" Background="{x:Null}" Foreground="White" BorderBrush="{x:Null}" FontSize="10"/>
        <Image HorizontalAlignment="Left" Height="300" Margin="19,75,0,0" Grid.Row="2" VerticalAlignment="Top" Width="198" Panel.ZIndex="2" Source="/Fadriass.png"/>
        <Image HorizontalAlignment="Left" Height="239" Margin="800,77,0,0" Grid.Row="2" VerticalAlignment="Top" Width="199" Panel.ZIndex="2" Source="/Fùchóu.png"/>
        <Image HorizontalAlignment="Left" Height="293"Height="274" Margin="318,-79,0,0"Margin="21,-179,0,0" VerticalAlignment="Top" Width="713" RenderTransformOrigin="0.5,0.5" Panel.ZIndex="1" Source="/Background_Top.png" Grid.RowSpan="3">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.982"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.857"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <TextBox HorizontalAlignment="Left" Margin="90,-59,0,0" Grid.Row="2" TextWrapping="Wrap" Text="PHASE DE RESOLUTION" VerticalAlignment="Top" Width="310" Panel.ZIndex="2" Background="#7F000000" Foreground="#B2FF0000" FontSize="23" BorderBrush="{x:Null}" FontFamily="Castellar"/>
        <Image HorizontalAlignment="Left" Height="256" Margin="454,-137,0,0" Grid.RowSpan="3" VerticalAlignment="Top" Width="557" Panel.ZIndex="1" Source="/Background_State.png"/>

        <!-- ZONE DU JOURNAL DE L'AVENTURE -->
    </Grid>
</Window>
