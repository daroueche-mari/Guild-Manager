<Window x:Class="GuildManager.ChoiceCharacter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Sélection des Aventuriers" Height="650" Width="1050" Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Zone principale de sélection -->
            <RowDefinition Height="*"/>
            <!-- Pied de page et boutons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="PREPARATION DE LA QUÊTE" Foreground="#FFFFCE00" FontSize="20" FontWeight="Bold" FontFamily="Castellar"/>
                <TextBlock x:Name="TxtNomQuete" Text="Quête : [Nom de la quête sélectionnée]" Foreground="#FF00FFF1" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Click="AnnulerBtn_Click" Content="Annuler" HorizontalAlignment="Right" Width="100" Height="30" Background="#333333" Foreground="White" BorderBrush="Gray" Cursor="Hand"/>
        </DockPanel>

        <!-- LISTE DES AVENTURIERS DISPONIBLES (SELECTION MULTIPLE) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Sélectionnez les membres de l'escouade" Foreground="#FFFFCE00" BorderBrush="#55FFFFFF" Background="#2A2A2A" Padding="10">
                <ListView x:Name="ListViewAventuriers" 
                          SelectionMode="Multiple" 
                          Background="#1E1E1E" 
                          Foreground="White" 
                          BorderThickness="0">

                    <!-- Disposition sous forme de cartes / grille d'aventuriers -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="970"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <!-- Template d'un aventurier -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Height="100" Margin="5" Background="#333333" BorderBrush="#FFFFCE00" BorderThickness="1" CornerRadius="4" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Portrait -->
                                    <Image Grid.Column="0" Source="{Binding ImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Infos aventurier -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nom}" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Classe}" Foreground="#FF00FF17" FontSize="11" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Niv. " Foreground="Gray" FontSize="11"/>
                                            <TextBlock Text="{Binding Niveau}" Foreground="#FF00FFF1" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>
        </Grid>

        <!-- PIED DE PAGE : CONFIRMATION -->
        <DockPanel Grid.Row="2" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Aventuriers sélectionnés : " Foreground="White" FontSize="13"/>
                <TextBlock x:Name="TxtCountSelection" Text="0" Foreground="#FFFFCE00" FontWeight="Bold" FontSize="13"/>
            </StackPanel>

            <Button Click="LancerQueteBtn_Click" Content="Lancer l'Expédition" HorizontalAlignment="Right" Width="180" Height="40" Background="#B2F10000" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>