<Window x:Class="GuildManager.AdventurerManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Gestionnaire d'Aventuriers" Height="650" Width="1050" Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid Principal -->
            <RowDefinition Height="*"/>
            <!-- Pied de page avec actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="REGISTRE DES AVENTURIERS" Foreground="#FFFFCE00" FontSize="22" FontWeight="Bold" FontFamily="Castellar" VerticalAlignment="Center"/>
            <Button Click="ShowAddAdventurerWindowBtn" Content="+ Recruter Aventurier" HorizontalAlignment="Right" Width="160" Height="32" Background="#B2F10000" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </DockPanel>

        <!-- TABLEAU DATAGRID -->
        <DataGrid x:Name="DataGridAventuriers" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  RowHeight="50"
                  Background="#2A2A2A" 
                  RowBackground="#333333" 
                  AlternatingRowBackground="#2C2C2C" 
                  Foreground="White" 
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#444444"
                  BorderThickness="1"
                  BorderBrush="#555555">

            <!-- STYLE DES EN-TÊTES DE COLONNES -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#151515"/>
                    <Setter Property="Foreground" Value="#FFFFCE00"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- COLONNE AVATAR -->
                <DataGridTemplateColumn Header="Portrait" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}" Width="35" Height="42" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- COLONNE NOM -->
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" FontSize="13" FontWeight="Bold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- COLONNE CLASSE -->
                <DataGridTextColumn Header="Classe" Binding="{Binding Classe}" Width="150" Foreground="#FF00FF17">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- COLONNE NIVEAU -->
                <DataGridTextColumn Header="Niveau" Binding="{Binding Niveau}" Width="90" Foreground="#FF00FFF1">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- COLONNE STATUT / SPÉCIAL -->
                <DataGridTextColumn Header="Type" Binding="{Binding TypeAventurier}" Width="120" Foreground="#FFFFB700">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- COLONNE ACTION -->
                <DataGridTemplateColumn Header="Action" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Renvoyer" Click="RenvoieAventurierBtn_Click" Background="#441111" Foreground="#FFFF7777" BorderBrush="Red" Width="80" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PIED DE PAGE -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Click="BackToMenuFromAdventurerManagerBtn" Content="Retour à la Guilde" Width="140" Height="30" Background="#333333" Foreground="White" BorderBrush="Gray" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>