<Window x:Class="GuildManager.AddCharacters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Recruter un Aventurier" Height="650" Width="1050" Background="#1E1E1E">

    <Grid>
        <!-- HEADER -->
        <Image x:Name="SupportTitreFenetreAjouterPersonnage" HorizontalAlignment="Left" Height="274" Margin="18,-111,0,0" VerticalAlignment="Top" Width="713" Panel.ZIndex="1" Source="/assets/Ui/Background/Background_Top.png"/>
        <TextBlock x:Name="TitreFenetreAjouterPersonnage" HorizontalAlignment="Left" Margin="87,9,0,0" TextWrapping="Wrap" Text="RECRUTER AVENTURIER" VerticalAlignment="Top" Width="330" Panel.ZIndex="2" Background="#7F000000" Foreground="#B2FF0000" FontSize="21" FontFamily="Castellar"/>

        <Button Click="BackToMenuFromCharacterWindowBtn" Content="Fermer" HorizontalAlignment="Left" Margin="900,20,0,0" VerticalAlignment="Top" Panel.ZIndex="2" Width="108" Height="30" Foreground="White" Background="#333333" BorderBrush="Gray" Cursor="Hand"/>

        <!-- PANNEAU CENTRAL / FORMULAIRE -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Height="420" Margin="0,40,0,0">
            <!-- Arrière-plan du formulaire -->
            <Rectangle Fill="#2A2A2A" Stroke="#FFFFCE00" StrokeThickness="1" RadiusX="8" RadiusY="8"/>

            <StackPanel Margin="30" VerticalAlignment="Center">
                <TextBlock Text="Nouveau Membre" Foreground="#FFFFCE00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25" FontFamily="Castellar"/>

                <!-- SELECTION DE LA CLASSE -->
                <TextBlock Text="Classe de l'aventurier :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="Classeforaddcharacter" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center" Background="#333333" Foreground="White">
                    <ComboBoxItem Content="Guerrier" IsSelected="True"/>
                    <ComboBoxItem Content="Barbare"/>
                    <ComboBoxItem Content="Tank"/>
                    <ComboBoxItem Content="Voleur"/>
                    <ComboBoxItem Content="Rôdeur"/>
                    <ComboBoxItem Content="Mage"/>
                    <ComboBoxItem Content="Prêtre"/>
                </ComboBox>

                <!-- NOM DE L'AVENTURIER -->
                <TextBlock Text="Nom de l'aventurier :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="Nomforaddcharacter" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center" Background="#33000000" BorderBrush="#55FFFFFF" Foreground="White" Padding="5,0"/>

                <!-- CHEMIN DE L'IMAGE / PORTRAIT -->
                <TextBlock Text="Chemin de l'image (Portrait) :" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="Imagepathforaddcharacter" Height="30" Margin="0,0,0,25" VerticalContentAlignment="Center" Background="#33000000" BorderBrush="#55FFFFFF" Foreground="White" Padding="5,0" Text="/assets/Personnages/Aventuriers/Icon/Default_Avatar.png"/>

                <!-- BOUTON DE VALIDATION -->
                <Button Click="NewAdventurerBtn" Content="Confirmer le Recrutement" Height="40" Background="#B2F10000" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>