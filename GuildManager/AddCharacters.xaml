<Window x:Class="GuildManager.AddCharacters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="AddCharacters" Height="650" Width="1050">
    <Grid Background="#E5000000" RenderTransformOrigin="0.497,0.498">
        <ComboBox x:Name="Classeforaddcharacter" HorizontalAlignment="Center" Margin="0,272,0,0" VerticalAlignment="Top" Width="120" Panel.ZIndex="2">
            <ComboBoxItem Content="Guerrier" />
            <ComboBoxItem Content="Barbare" />
            <ComboBoxItem Content="Tank" />
            <ComboBoxItem Content="Voleur" />
            <ComboBoxItem Content="Rodeur" />
            <ComboBoxItem Content="Mage" />
            <ComboBoxItem Content="Pretre" />
        </ComboBox>
        <TextBox x:Name="Nomforaddcharacter" HorizontalAlignment="Center" Margin="0,322,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="#33000000" BorderBrush="#33ABADB3" Panel.ZIndex="2" Foreground="White"/>
        <Rectangle HorizontalAlignment="Center" Height="317" Stroke="Black" VerticalAlignment="Center" Width="352" Fill="#260003FF" Panel.ZIndex="1"/>
        <Rectangle HorizontalAlignment="Center" Height="177" Stroke="#33D1D1D1" VerticalAlignment="Center" Width="204" Panel.ZIndex="1"/>
        <TextBox HorizontalAlignment="Center" Margin="0,179,0,0" TextWrapping="Wrap" Text="AJOUTER UN PERSONNAGE" VerticalAlignment="Top" Width="234" Panel.ZIndex="2" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="18"/>
        <Image x:Name="SupportTitreFenetreAjouterPersonnage" HorizontalAlignment="Left" Height="274" Margin="18,-111,0,0" VerticalAlignment="Top" Width="713" Panel.ZIndex="1" Source="/assets/Ui/Background/Background_Top.png"/>
        <TextBox x:Name="TitreFenetreAjouterPersonnage" IsReadOnly="True" HorizontalAlignment="Left" Margin="87,9,0,0" TextWrapping="Wrap" Text="AJOUTER PERSONNAGE" VerticalAlignment="Top" Width="330" Panel.ZIndex="2" Background="#7F000000" Foreground="#B2FF0000" FontSize="21" BorderBrush="{x:Null}" FontFamily="Castellar"/>
        <Button Click="NewAdventurerBtn" Content="Valider" HorizontalAlignment="Center" Margin="0,433,0,0" VerticalAlignment="Top" Panel.ZIndex="2" Width="92" Foreground="White" Background="#FF002663"/>
        <Button Click="BackToMenuFromCharacterWindowBtn" Content="Retour au menu" HorizontalAlignment="Left" Margin="900,99,0,0" VerticalAlignment="Top" Panel.ZIndex="2" Width="108" Foreground="White" Background="#FF002663"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,250,0,0" TextWrapping="Wrap" Text="Choisissez la classe" VerticalAlignment="Top" Panel.ZIndex="2" Width="120" Foreground="White" IsEnabled="False"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,300,0,0" TextWrapping="Wrap" Text="Choisissez le nom" VerticalAlignment="Top" Panel.ZIndex="2" Width="120" Foreground="White" IsEnabled="False"/>
        <TextBlock HorizontalAlignment="Left" Margin="437,354,0,0" TextWrapping="Wrap" Text="Chemin de l'image" VerticalAlignment="Top" Panel.ZIndex="2" Width="120" Foreground="White" IsEnabled="False"/>
        <TextBox x:Name="Imagepathforaddcharacter" HorizontalAlignment="Center" Margin="0,375,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="184" Background="#33000000" BorderBrush="#33ABADB3" Panel.ZIndex="2" Foreground="White"/>

    </Grid>
</Window>
