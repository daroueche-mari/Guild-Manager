        <TextBlock x:Name="ChoixAventurierTxt_Copy" Grid.Column="1" HorizontalAlignment="Left" Margin="337,379,0,0" Grid.Row="2" Text="Choix Aventurier 2" VerticalAlignment="Top" Width="105" Foreground="#FFF5D500" Background="#4C000000" />
        <TextBlock x:Name="ChoixAventurierTxt" Grid.Column="1" HorizontalAlignment="Left" Margin="337,440,0,0" Grid.Row="2" Text="Choix Aventurier 3" VerticalAlignment="Top" Width="105" Foreground="#FFF5D500" Background="#4C000000" />

        <ComboBox x:Name="Aventurier1Choix" Grid.Column="1" HorizontalAlignment="Left" Margin="153,404,0,0" Grid.Row="2" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="Fùchóu"/>
            <ComboBoxItem Content="Hēi Jiǔ"/>
            <ComboBoxItem Content="Zhìyuān"/>
        </ComboBox>
        <ComboBox x:Name="Aventurier2Choix" Grid.Column="1" HorizontalAlignment="Left" Margin="322,404,0,0" Grid.Row="2" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="Dwargo" />
            <ComboBoxItem Content="Sulvar" />
            <ComboBoxItem Content="Stark" />
        </ComboBox>
        <ComboBox x:Name="Aventurier3Choix" Grid.Column="1" HorizontalAlignment="Left" Margin="323,463,0,0" Grid.Row="2" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="Ualiar" />
            <ComboBoxItem Content="Salgar" />
            <ComboBoxItem Content="Eryndel" />
            <ComboBoxItem Content="Thalion" />
        </ComboBox>
        <Button Click="GiveLvlBtn" Grid.Column="1" Content="Level +1 1000 Or" HorizontalAlignment="Left" Margin="40,73,0,0" Grid.RowSpan="3" VerticalAlignment="Top" Width="109" Background="{x:Null}" Foreground="#FFFFFA00" BorderBrush="#FFFFDE00"/>
        <Button Click="NewGameBtn" Grid.Column="1" Content="Nouvelle Partie" HorizontalAlignment="Left" Margin="128,-57,0,0" VerticalAlignment="Top" Panel.ZIndex="1" Width="96" Background="{x:Null}" Foreground="White" BorderBrush="#FF5CFF00" Height="23"/>

    </Grid>
</Window>