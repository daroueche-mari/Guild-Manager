<Window x:Class="GuildManager.Register_Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d"
        Title="Register_Login" Height="650" Width="1050" Background="#4C000000">
    <Grid OpacityMask="#FFEA6969">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="163*"/>
            <ColumnDefinition Width="187*"/>
        </Grid.ColumnDefinitions>
        <!-- HEADER -->
        <Image x:Name="SupportTitreFenetreConnexion" HorizontalAlignment="Left" Height="274" Margin="18,-111,0,0" VerticalAlignment="Top" Width="713" Panel.ZIndex="1" Source="/assets/UI/Background/Background_Top.png" Grid.ColumnSpan="2"/>
        <TextBox x:Name="TitreFenetrerConnexion" IsReadOnly="True" HorizontalAlignment="Left" Margin="87,9,0,0" TextWrapping="Wrap" Text="CONNEXION/INSCRIPTION" VerticalAlignment="Top" Width="330" Panel.ZIndex="2" Background="#7F000000" Foreground="#B2FF0000" FontSize="21" BorderBrush="{x:Null}" FontFamily="Castellar"/>
        <Rectangle HorizontalAlignment="Left" Height="418" Margin="38,145,0,0" Stroke="Black" VerticalAlignment="Top" Width="441" Fill="#260003FF"/>
        <Rectangle HorizontalAlignment="Center" Height="418" Margin="0,145,0,0" Stroke="Black" VerticalAlignment="Top" Width="441" Fill="#260003FF" Grid.Column="1"/>
        <TextBox HorizontalAlignment="Left" Margin="215,163,0,0" TextWrapping="Wrap" Text="INSCRIPTION" VerticalAlignment="Top" Width="122" FontSize="18" Background="{x:Null}" Foreground="White" BorderBrush="{x:Null}"/>
        <TextBox HorizontalAlignment="Center" Margin="0,163,0,0" TextWrapping="Wrap" Text="CONNEXION" VerticalAlignment="Top" Width="122" FontSize="18" Background="{x:Null}" Foreground="White" BorderBrush="{x:Null}" Grid.Column="1"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="122,271,0,0" TextWrapping="Wrap" Text="Nom " VerticalAlignment="Top" Width="53" Background="{x:Null}" Foreground="White" BorderBrush="{x:Null}" Panel.ZIndex="2"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="122,317,0,0" TextWrapping="Wrap" Text="Mot de passe" VerticalAlignment="Top" Width="102" Background="{x:Null}" Foreground="White" BorderBrush="{x:Null}" Panel.ZIndex="2"/>
        <Button Content="S'Inscrire" HorizontalAlignment="Center" Margin="0,401,0,0" VerticalAlignment="Top" Panel.ZIndex="2" Width="116" Background="#FF002663" Foreground="White" Height="24"/>
        <Rectangle HorizontalAlignment="Center" Height="214" Stroke="#33FFFFFF" VerticalAlignment="Top" Width="306" Panel.ZIndex="1" Margin="0,222,0,0"/>
        <TextBox HorizontalAlignment="Left" Margin="126,294,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="193" Panel.ZIndex="1" Background="#33000000" BorderBrush="#4CABADB3"/>
        <TextBox HorizontalAlignment="Left" Margin="126,340,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="193" Panel.ZIndex="1" Background="#33000000" BorderBrush="#4CABADB3" Foreground="White"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="145,267,0,0" TextWrapping="Wrap" Text="Nom " VerticalAlignment="Top" Width="52" Background="{x:Null}" Foreground="White" BorderBrush="{x:Null}" Panel.ZIndex="2" Grid.Column="1"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="145,313,0,0" TextWrapping="Wrap" Text="Mot de passe" VerticalAlignment="Top" Width="102" Background="{x:Null}" Foreground="White" BorderBrush="{x:Null}" Panel.ZIndex="2" Grid.Column="1"/>
        <Button Content="Connexion" HorizontalAlignment="Left" Margin="209,397,0,0" VerticalAlignment="Top" Panel.ZIndex="2" Width="116" Background="#FF002663" Foreground="White" Height="24" Grid.Column="1"/>
        <Rectangle HorizontalAlignment="Left" Height="214" Stroke="#33FFFFFF" VerticalAlignment="Top" Width="306" Panel.ZIndex="1" Margin="114,218,0,0" Grid.Column="1"/>
        <TextBox HorizontalAlignment="Left" Margin="149,290,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="192" Panel.ZIndex="1" Background="#33000000" BorderBrush="#4CABADB3" Grid.Column="1"/>
        <TextBox HorizontalAlignment="Left" Margin="149,336,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="192" Panel.ZIndex="1" Background="#33000000" BorderBrush="#4CABADB3" Foreground="White" Grid.Column="1"/>
        <Button Click="BacktoMenuFromLogWindowBtn" Content="Retour au menu" HorizontalAlignment="Left" Margin="417,96,0,0" VerticalAlignment="Top" Panel.ZIndex="2" Width="116" Background="#FF002663" Foreground="White" Height="24" Grid.Column="1"/>
    </Grid>
</Window>
