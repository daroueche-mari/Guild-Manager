        <TextBox x:Name="NombreGoldFenetreMain" IsReadOnly="True" Margin="511,-56,1,0" TextWrapping="Wrap" Text="Gold" VerticalAlignment="Top" Height="20" Panel.ZIndex="2" Background="{x:Null}" Foreground="#FFFFFD00"/>
